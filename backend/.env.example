# AgriConnect (SIH26033) — Environment Configuration
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string for the AgriConnect database.
# AgriConnect uses its OWN database (sih26033) — do NOT point this
# at any other project's database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sih26033"

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET="replace_with_a_long_random_string_min_16_chars"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────
PORT="5001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# ─── Government Mandi API (data.gov.in) ───────────────────────
# Register for a free API key at https://data.gov.in/
MANDI_API_KEY="YOUR_DATAGOV_IN_API_KEY"
MANDI_API_URL="https://api.data.gov.in"
MANDI_RESOURCE_ID="YOUR_MANDI_RESOURCE_ID"
MANDI_API_FORMAT="json"

# ─── Government Variety-wise API (data.gov.in) ────────────────
VARIETY_API_KEY="YOUR_DATAGOV_IN_API_KEY"
VARIETY_API_URL="https://api.data.gov.in"
VARIETY_RESOURCE_ID="YOUR_VARIETY_RESOURCE_ID"

# ─── Historical Dataset (optional) ────────────────────────────
# Optional path to a local CSV/JSON historical dataset.
# Leave empty to rely on the AGMARKNET API importer instead
# (see docs/DATA_SOURCES.md).
HISTORICAL_DATA_PATH=""
YEAR_START="2008"
YEAR_END="2022"

# ─── Routing Provider (logistics) ─────────────────────────────
# Supported: openrouteservice | osrm | google | mapbox
ROUTING_PROVIDER="openrouteservice"
ROUTING_API_KEY="YOUR_ROUTING_API_KEY"
ROUTING_API_URL="https://api.heigit.org/openrouteservice"
ROUTING_ENDPOINT="https://api.heigit.org/openrouteservice"

# ─── Brevo SMTP Email Provider (OTP Auth) ─────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL="agriconnect.marketplace@gmail.com"
BREVO_SENDER_NAME="AgriConnect"
